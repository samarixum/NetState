<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetState.Client.ViewModels"
        xmlns:conv="using:NetState.Client.Converters"
        x:Class="NetState.Client.Views.InspectDomainWindow"
        x:DataType="vm:InspectDomainViewModel"
        Title="Inspect Entry Details"
        Width="720" Height="620"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
            <DockPanel>
                <Border DockPanel.Dock="Right"
                        CornerRadius="4"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{Binding Domain.LastStatus, Converter={StaticResource StatusToBrushConverter}}">
                    <TextBlock Text="{Binding Domain.LastStatus}" Foreground="White" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="{Binding Domain.Name}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding Domain.Url}" Opacity="0.8" FontSize="13"/>
            <TextBlock Text="{Binding ConfigurationSummary}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LastErrorText, StringFormat=Last Error: {0}}" FontSize="12" Foreground="OrangeRed" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="10">
                <Expander Header="Expected Value" IsExpanded="False" HorizontalAlignment="Stretch">
                    <TextBox Text="{Binding ExpectedValueText, Mode=OneWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             MaxHeight="160"/>
                </Expander>

                <Expander Header="{Binding MiscDnsHeader}" IsExpanded="True" HorizontalAlignment="Stretch">
                    <DataGrid ItemsSource="{Binding MiscDnsRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="190" x:DataType="vm:KeyValueRow"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" x:DataType="vm:KeyValueRow"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <Expander Header="{Binding ExpectedHeadersTitle}" IsExpanded="False" HorizontalAlignment="Stretch">
                    <DataGrid ItemsSource="{Binding ExpectedHeaderRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Header" Binding="{Binding Key}" Width="190" x:DataType="vm:KeyValueRow"/>
                            <DataGridTextColumn Header="Expected Value" Binding="{Binding Value}" Width="*" x:DataType="vm:KeyValueRow"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <Expander Header="{Binding ResponseHeadersTitle}" IsExpanded="True" HorizontalAlignment="Stretch">
                    <DataGrid ItemsSource="{Binding Headers}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Header / Metadata" Binding="{Binding Key}" Width="190" x:DataType="vm:KeyValueRow"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" x:DataType="vm:KeyValueRow"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <Expander Header="Response Body / DNS Results" IsExpanded="True" HorizontalAlignment="Stretch">
                    <TextBox Text="{Binding ResponseBody, Mode=OneWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             MaxHeight="280"
                             Margin="0,5,0,0"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
