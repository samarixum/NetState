<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:NetState.Client.ViewModels"
        mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="460"
        x:Class="NetState.Client.Views.MiscDnsValuesWindow"
        x:DataType="vm:MiscDnsValuesViewModel"
        Title="Misc DNS Values &amp; Assertions"
        Width="600" Height="480"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" HorizontalContentAlignment="Center"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Width="80" HorizontalContentAlignment="Center" Background="#0078D7" Foreground="White" HotKey="Enter"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="Store arbitrary DNS metadata (ProxyStatus, TunnelName, WorkerService, R2Bucket) or optional validation directives (AssertContains, AssertMaxTtl, AssertDnsServer, IgnoreSoaSerial, AssertNoOtherRecordTypes, EnableCrtSh)."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Opacity="0.8"/>

            <Grid ColumnDefinitions="160, 140, *, Auto" ColumnSpacing="6">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding PresetKeys}"
                          SelectedItem="{Binding SelectedPresetKey}"
                          PlaceholderText="Presets..."
                          HorizontalAlignment="Stretch"/>
                <TextBox Grid.Column="1" Text="{Binding NewKey}" Watermark="Key"/>
                <TextBox Grid.Column="2" Text="{Binding NewValue}" Watermark="Value"/>
                <Button Grid.Column="3" Content="Add / Set" Command="{Binding AddEntryCommand}" Background="#0078D7" Foreground="White"/>
            </Grid>
        </StackPanel>

        <ListBox ItemsSource="{Binding Entries}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MiscDnsEntry">
                    <Grid ColumnDefinitions="170, *, Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding Key}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="Remove"
                                Command="{Binding $parent[ListBox].((vm:MiscDnsValuesViewModel)DataContext).RemoveEntryCommand}"
                                CommandParameter="{Binding}"
                                Foreground="Crimson"
                                VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
