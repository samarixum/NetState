<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:NetState.Client.ViewModels"
        xmlns:conv="using:NetState.Client.Converters"
        xmlns:models="using:NetState.Shared.Models"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="NetState.Client.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NetState Monitor">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">  
            <Button Command="{Binding LoadDomainsCommand}" Margin="5">Refresh</Button>
            <Button Command="{Binding AddDomainCommand}" Margin="5" Background="#0078D7" Foreground="White">Add Domain</Button>
            <TextBlock Text="NetState Monitor" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0" FontSize="18"/>
            <TextBlock Text="● Connected" IsVisible="{Binding IsConnected}" Foreground="Green" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
            <TextBlock Text="● Disconnected" IsVisible="{Binding !IsConnected}" Foreground="Red" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0"/>
        </StackPanel>

        <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}" Height="4"/>

        <DataGrid Margin="10" ItemsSource="{Binding Domains}" 
                  AutoGenerateColumns="False" IsReadOnly="True" 
                  GridLinesVisibility="All" BorderThickness="1" BorderBrush="Gray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:MonitoredDomain">
                            <Border CornerRadius="4" Padding="5,2" HorizontalAlignment="Center" 
                                    Background="{Binding LastStatus, Converter={StaticResource StatusToBrushConverter}}">
                                <TextBlock Text="{Binding LastStatus}" Foreground="White" FontWeight="Bold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Last Checked" Binding="{Binding LastChecked, StringFormat=\{0:HH:mm:ss\}}" Width="120" />
                <DataGridTemplateColumn Header="Actions" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:MonitoredDomain">
                            <Button Content="Delete" 
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteDomainCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Crimson" Foreground="White"
                                    Padding="10,2" CornerRadius="3"
                                    HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>


